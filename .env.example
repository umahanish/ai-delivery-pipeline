# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# --- Knowledge store -------------------------------------------------------
# Local Docker Postgres by default (port 5433, not 5432 — see
# docker-compose.yml's comment, the sibling devops-knowledge-mcp project's
# own Postgres already uses 5432). Can also point at a real hosted Postgres
# (Render, Neon, RDS, etc.) with no code change — src/db/pgSsl.ts turns SSL
# on automatically for any non-localhost host. (SingleStore was considered
# as a hosted option but isn't Postgres-wire-protocol compatible — it's a
# genuinely different database, not a drop-in swap; see docs/DECISIONS.md.)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/delivery_pipeline
# A separate database, not just a separate table — `npm test` TRUNCATEs
# backlog_items/pipeline_events before every test. Must never equal
# DATABASE_URL (tests/helpers/db.ts refuses to start if it does). Kept
# local even when DATABASE_URL points at a hosted DB — no reason to pay
# cloud round-trip latency for a table that gets wiped every test run.
# Create it once with: docker compose exec postgres createdb -U postgres delivery_pipeline_test
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/delivery_pipeline_test

# --- JIRA (Phase 3 — required for the backlog UI to work) -------------------
JIRA_BASE_URL=       # e.g. https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=    # e.g. SCRUM — the project new backlog items are created in
# Not every JIRA site has a "Story" issue type — team-managed/simplified
# projects often don't. Set this to whatever issue type your project
# actually has if "Task" isn't right for you.
JIRA_ISSUE_TYPE=Task

# --- GitHub (Phase 4+) -------------------------------------------------------
GITHUB_TOKEN=

# --- Coding agent (Phase 4+) -------------------------------------------------
ANTHROPIC_API_KEY=

# --- Target repo's CI/deploy (Phase 5+/6) -----------------------------------
# Not env vars here. SonarCloud, Trivy, Render, and OWASP ZAP all run
# inside delivery-pipeline-sample-app's own GitHub Actions workflows
# (.github/workflows/ci.yml, deploy.yml), authenticated with secrets set
# directly on THAT repo (SONAR_TOKEN, RENDER_API_KEY, RENDER_SERVICE_ID via
# `gh secret set --repo umahanish/delivery-pipeline-sample-app`), not this
# project's .env. This project only ever reaches out to GitHub's own API
# afterward to find out what happened — see
# src/orchestrator/deployStatus.ts and `npm run sync-deploy-status`.
